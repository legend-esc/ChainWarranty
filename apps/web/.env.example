# apps/web environment variables
# Copy to .env.local and fill in your values.

# Required: deployed contract ID from Day 1 testnet deployment
NEXT_PUBLIC_CONTRACT_ID=CDXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Soroban RPC endpoint (public, safe to expose)
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org

# Server-only: Postgres connection string for the indexer DB
# Used by /api/claims and /api/manufacturers routes.
INDEXER_DATABASE_URL=postgresql://user:password@localhost:5432/chainwarranty

