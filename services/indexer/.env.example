# ChainWarranty Indexer — environment variables
# Copy to .env and fill in your values.

# Required: deployed contract ID from Day 1 testnet deployment
CONTRACT_ID=CDXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Soroban RPC endpoint
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Postgres connection string
DATABASE_URL=postgresql://user:password@localhost:5432/chainwarranty

# How often to poll for new events (milliseconds)
POLL_INTERVAL_MS=5000
