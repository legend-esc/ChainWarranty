{
  "name": "@chainwarranty/indexer",
  "version": "0.1.0",
  "description": "Event-listener service: subscribes to ChainWarranty contract events and writes to Postgres",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "@chainwarranty/sdk": "workspace:*",
    "@stellar/stellar-sdk": "12.3.0",
    "pg": "8.13.3",
    "dotenv": "16.4.7"
  },
  "devDependencies": {
    "@types/pg": "8.11.11",
    "tsx": "4.19.2",
    "typescript": "5.4.5"
  }
}
